# Sign up to Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Create a new Clerk webhook (user.created event) with your app URL and append /webhooks/clerk
# Set the webhook secret below provided by Clerk
CLERK_WEBHOOK_SECRET=

# Control database: records which database belongs to which user.
# turso db create control && turso db show control --url
# For local development you can use a file, e.g. file:control.db
CONTROL_DATABASE_URL=
# turso db tokens create control (leave empty for a file: URL)
CONTROL_DATABASE_AUTH_TOKEN=

# Where each user's database is created: turso (default), bunny, or local (SQLite files in .tenants/)
DB_PROVIDER=turso

# Encrypts per-database tokens stored in the control database.
# Required for Bunny. Not needed for Turso, which uses one group token.
# openssl rand -base64 32
TENANT_TOKEN_ENCRYPTION_KEY=

# turso auth api-tokens mint clerk
TURSO_API_TOKEN=

# your personal or organization name
TURSO_ORG=

# The group new databases are created in (default: default)
TURSO_GROUP=

# turso group tokens create <group-name>
TURSO_GROUP_AUTH_TOKEN=

# --- Bunny Database (DB_PROVIDER=bunny) ---

# An API key from the bunny.net dashboard. A key limited to the Database
# permissions (Create, Read, Update, Delete) is enough.
BUNNYNET_API_KEY=

# Where data is stored at rest, e.g. eu-west-1 (see GET /v3/config)
BUNNY_DB_STORAGE_REGION=

# Comma-separated region codes, e.g. DE or DE,UK
BUNNY_DB_PRIMARY_REGIONS=

# Optional read replicas, e.g. NY,SG
BUNNY_DB_REPLICA_REGIONS=
